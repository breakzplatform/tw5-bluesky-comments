tags: $:/tags/Stylesheet
title: $:/plugins/breakzplatform/bluesky-comments/stylesheet
type: text/vnd.tiddlywiki

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline

.breakzplatform-bluesky-comments-toggle {
	display: block;
	width: 100%;
	text-align: right;
}

.breakzplatform-bluesky-comments-toggle svg {
	width: 1rem;
	height: 1rem;
	vertical-align: middle;
}

.bsky-comments {
	margin: 0.5em 0 1em;
}

.bsky-comments-header {
	display: flex;
	flex-wrap: wrap;
	justify-content: space-between;
	align-items: center;
	gap: 0.5em;
	padding-bottom: 0.5em;
	margin-bottom: 0.75em;
	border-bottom: 1px solid <<colour table-border>>;
}

.bsky-comments-counts,
.bsky-comment-counts,
.bsky-comment-handle,
.bsky-comment-date,
.bsky-comments-loading,
.bsky-comment-placeholder {
	color: <<colour muted-foreground>>;
}

.bsky-comments-reply-link {
	font-weight: bold;
}

.bsky-comments-warning {
	color: <<colour alert-foreground>>;
}

.bsky-comments-message {
	margin: 0.5em 0;
}

.bsky-comment {
	margin: 0.75em 0;
}

.bsky-comment-replies {
	margin-left: 1em;
	padding-left: 0.75em;
	border-left: 2px solid <<colour table-border>>;
}

.bsky-comment-meta {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 0.25em 0.5em;
	font-size: 0.9em;
}

.bsky-comment-avatar {
	width: 28px;
	height: 28px;
	border-radius: 50%;
	vertical-align: middle;
	object-fit: cover;
}

.bsky-comments a.bsky-comment-author,
.bsky-comments a.bsky-comment-date,
.bsky-comments a.bsky-comment-avatar-link {
	text-decoration: none;
}

.bsky-comment-name {
	font-weight: bold;
	color: <<colour foreground>>;
}

.bsky-comment-text {
	margin: 0.25em 0;
	white-space: pre-wrap;
	overflow-wrap: anywhere;
}

.bsky-comment-images {
	display: flex;
	flex-wrap: wrap;
	gap: 0.25em;
}

.bsky-comment-image {
	max-width: 160px;
	max-height: 160px;
	border-radius: 4px;
	object-fit: cover;
}

.bsky-comment-card {
	display: inline-block;
	padding: 0.25em 0.5em;
	border: 1px solid <<colour table-border>>;
	border-radius: 4px;
}

.bsky-comment-embed,
.bsky-comment-counts {
	font-size: 0.85em;
	margin: 0.25em 0;
}
